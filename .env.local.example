# ========== LLM 配置 ==========
# 模型提供商：minimax / deepseek / qwen / openai / claude / custom
LLM_PROVIDER=minimax
# API Key（必填）
LLM_API_KEY=
# 自定义模型名（可选，覆盖默认值）
# LLM_MODEL=
# 自定义 API 地址（可选，custom 时必填）
# LLM_BASE_URL=

# ========== 飞书配置 ==========
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# ========== 微信测试号配置 ==========
# 自定的接口 Token（测试号后台「服务器配置」里填同一个值）
WECHAT_TOKEN=
# 测试号的 appID / appSecret（扫码申请后页面顶部可见）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 管理员 openid（你的微信在测试号里的身份 ID）：不配时所有人都能用收集功能，
# 首次发消息后回复里会附带你的 openid，填进来后其他人自动切换为「仅记账」
WECHAT_ADMIN_OPENID=

# ========== 企业微信自建应用配置（比测试号推送稳定，正式方案） ==========
# 我的企业 → 企业信息 → 企业 ID
WECOM_CORP_ID=
# 应用管理 → 自建应用 → AgentId
WECOM_AGENT_ID=
# 自建应用的 Secret
WECOM_AGENT_SECRET=
# 应用 → 接收消息 → 设置回调时自己填的 Token（和后台保持一致）
WECOM_TOKEN=
# 同一页面随机生成的 EncodingAESKey（43 位）
WECOM_ENCODING_AES_KEY=
# 管理员 userid（通讯录里你的账号）：不配时所有成员都能用收集功能，
# 首次发消息后回复里会附带你的 userid，填进来后其他成员自动切换为「仅记账」
WECOM_ADMIN_USERID=

# ========== 坚果云 WebDAV（微信收集入库） ==========
# 根地址 = https://dav.jianguoyun.com/dav/<同步文件夹名>，文件夹需在坚果云网页端先建好
WEBDAV_BASE=
# 坚果云账号（邮箱）
WEBDAV_USER=
# 应用密码（账户信息 → 安全选项 → 添加应用密码），不是登录密码
WEBDAV_PASSWORD=

